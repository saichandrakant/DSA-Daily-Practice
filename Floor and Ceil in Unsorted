import java.util.Arrays;

class Solution {
    public int[] getFloorAndCeil(int x, int[] arr) {

        Arrays.sort(arr);

        int floor = lb(0, arr.length - 1, x, arr, -1);
        int ceil = ub(0, arr.length - 1, x, arr, -1);

        return new int[]{floor, ceil};
    }

    int lb(int start, int end, int target, int[] arr, int ans) {

        while (start <= end) {

            int mid = start + (end - start) / 2;

            if (arr[mid] <= target) {
                ans = arr[mid];
                start = mid + 1;
            } else {
                end = mid - 1;
            }
        }

        return ans;
    }

    int ub(int start, int end, int target, int[] arr, int ans) {

        while (start <= end) {

            int mid = start + (end - start) / 2;

            if (arr[mid] >= target) {
                ans = arr[mid];
                end = mid - 1;
            } else {
                start = mid + 1;
            }
        }

        return ans;
    }
}
