https://leetcode.com/problems/number-of-closed-islands/description/
class Pair {
    int row;
    int clm;

    Pair(int row, int clm) {
        this.row = row;
        this.clm = clm;
    }
}

class Solution {

    int[] rowDir = {-1, 0, 1, 0};
    int[] clmDir = {0, -1, 0, 1};

    public int closedIsland(int[][] grid) {

        int n = grid.length;
        int m = grid[0].length;

        int cnt = 0;
        int[][] vis = new int[n][m];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {

                if (grid[i][j] == 0 && vis[i][j] == 0) {

                    Queue<Pair> queue = new LinkedList<>();
                    queue.add(new Pair(i, j));

                    if (check(queue, vis, grid)) {
                        cnt++;
                    }
                }
            }
        }

        return cnt;
    }

    boolean check(Queue<Pair> queue, int[][] vis, int[][] grid) {

        int n = grid.length;
        int m = grid[0].length;

        boolean closed = true;

        while (!queue.isEmpty()) {

            Pair p = queue.poll();

            int row = p.row;
            int clm = p.clm;

            if (vis[row][clm] == 1) continue;

            vis[row][clm] = 1;

            if (row == 0 || row == n - 1 || clm == 0 || clm == m - 1) {
                closed = false;
            }

            for (int i = 0; i < 4; i++) {

                int rows = row + rowDir[i];
                int clms = clm + clmDir[i];

                if (rows >= 0 && rows < n &&
                    clms >= 0 && clms < m &&
                    vis[rows][clms] == 0 &&
                    grid[rows][clms] == 0) {

                    queue.add(new Pair(rows, clms));
                }
            }
        }

        return closed;
    }
}
