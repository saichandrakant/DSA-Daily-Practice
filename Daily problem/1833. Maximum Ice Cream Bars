https://leetcode.com/problems/maximum-ice-cream-bars/description/?envType=daily-question&envId=2026-06-21
class Solution {
    public int maxIceCream(int[] costs, int coins) {
        int sum=0;
        Arrays.sort(costs);
        for(int i=0;i<costs.length;i++)
        {
            if(coins>=costs[i])
            {
                sum++;
                coins=coins-costs[i];
            }
            else
            {
                break;
            }
        }
        return sum;
    }
}
