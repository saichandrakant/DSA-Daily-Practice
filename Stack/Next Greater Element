class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {
        // code here
        ArrayList<Integer>list=new ArrayList<>();
        Stack<Integer> st=new Stack<>();
        for(int i=arr.length-1;i>=0;i--)
        {
            int curr=arr[i];
            while(!st.isEmpty() && st.peek()<=arr[i])
            {
                st.pop();
            }
            if(st.isEmpty())
            {
                arr[i]=-1;
            }
            else
            {
                arr[i]=st.peek();
            }
            st.push(curr);
        }
        for(int i=0;i<arr.length;i++)
        {
            list.add(arr[i]);
        }
        return list;
    }
}
