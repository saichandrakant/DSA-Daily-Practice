https://leetcode.com/problems/daily-temperatures/description/
class Pair
{
    int a;
    int b;
    Pair(int a,int b)
    {
        this.a=a;
        this.b=b;
    }
}
class Solution {
    public int[] dailyTemperatures(int[] arr) {
        Stack<Pair> stack=new Stack<>();
        stack.push(new Pair(arr.length-1,arr[arr.length-1]));
        arr[arr.length-1]=0;
        for(int i=arr.length-2;i>=0;i--)
        {
            while(!stack.isEmpty() && arr[i]>=stack.peek().b)
            {
                stack.pop();
            }
            int temp=arr[i];
            if(!stack.isEmpty())
            {
                arr[i]=stack.peek().a-i;
            }
            else
            {
                arr[i]=0;
            }
            stack.push(new Pair(i,temp));
        }
        return arr;
    }
}
