https://leetcode.com/problems/permutation-in-string/description/
class Solution {
    public boolean checkInclusion(String s1, String s2) {
        if(s1.length()>s2.length())
        {
            return false;
        }
        int[] hash=new int[26];
        int[] hash1=new int[26];
        int k=s1.length();
        for(int i=0;i<s1.length();i++)
        {
            hash[s1.charAt(i)-'a']++;
        }
       int r=0;
       int l=0;
       while(r<s2.length())
       {
        hash1[s2.charAt(r)-'a']++;
        if(r-l+1>k)
        {
            hash1[s2.charAt(l)-'a']--;
            l++;
        }
        if(r-l+1==k && Arrays.equals(hash, hash1))
        {
            return true;
        }
        r++;
       }
        return false;
    }
}
