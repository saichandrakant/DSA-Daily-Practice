https://leetcode.com/problems/maximum-erasure-value/
class Solution {
    public int maximumUniqueSubarray(int[] nums) {
        HashMap<Integer,Integer> map=new HashMap<>();
        int l=0;
        int r=0;
        int sum=0;
        int ans=0;
        while(r<nums.length)
        {
            sum=sum+nums[r];
            while(map.containsKey(nums[r]))
            {
                map.remove(nums[l],l);
                sum=sum-nums[l];
                l++;
            }
            map.put(nums[r],r);
            ans=Math.max(ans,sum);
            r++;
        }
        return ans;
    }
}
