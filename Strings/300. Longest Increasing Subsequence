https://leetcode.com/problems/longest-increasing-subsequence/description/
class Solution {
    public int lengthOfLIS(int[] nums) {
        List<Integer> list=new ArrayList<>();
        for(int num:nums)
        {
            if(list.isEmpty() || num>list.get(list.size()-1))
            {
                list.add(num);
            }
            else
            {
                int index=lb(num,list);
                list.set(index,num);
            }
        }
        return list.size();
    }
    int lb(int num,List<Integer> list)
    {
        int left=0;
        int right=list.size()-1;
        while(left<=right)
        {
            int mid=(left+right)/2;
            if(list.get(mid)>=num)
            {
                right=mid-1;
            }
            else
            {
                left=mid+1;
            }
        }
        return left;
    }
}
