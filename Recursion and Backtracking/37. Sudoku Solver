https://leetcode.com/problems/sudoku-solver/
class Solution {

    public void solveSudoku(char[][] board) {
        solve(board);
    }

    boolean solve(char[][] board) {

        for (int i = 0; i < board.length; i++) {

            for (int j = 0; j < board[0].length; j++) {

                if (board[i][j] == '.') {

                    for (char k = '1'; k <= '9'; k++) {

                        if (isValid(i, j, board, k)) {

                            board[i][j] = k;

                            if (solve(board)) {
                                return true;
                            } else {
                                board[i][j] = '.';
                            }
                        }
                    }

                    return false;
                }
            }
        }

        return true;
    }

    boolean isValid(int row, int col, char[][] board, char c) {

        for (int i = 0; i < 9; i++) {

            // row check
            if (board[row][i] == c) {
                return false;
            }

            // column check
            if (board[i][col] == c) {
                return false;
            }

            // 3x3 box check
            if (board[3 * (row / 3) + i / 3]
                    [3 * (col / 3) + i % 3] == c) {
                return false;
            }
        }

        return true;
    }
}
