class Solution {
    public boolean canReach(int[] arr, int start) {
        boolean[] visited=new boolean[arr.length];
      return  rec(start,arr,visited);
    }
    boolean rec(int start,int[] nums,boolean[] visited)
    {
        if(start<0 || start>=nums.length)
        {
            return false;
        }
        if(visited[start])
        {

            return false;
        }

        if(nums[start]==0)
        {
            return true;
        }
        visited[start]=true;
        return rec(start+nums[start],nums,visited)|| rec(start-nums[start],nums,visited);
        
    }
}
