https://leetcode.com/problems/n-queens/description/
class Solution {

    List<List<String>> list = new ArrayList<>();

    public List<List<String>> solveNQueens(int n) {

        int[] pd = new int[n];           // row check
        int[] td = new int[2 * n - 1];  // top diagonal
        int[] ld = new int[2 * n - 1];  // lower diagonal

        char[][] arr = new char[n][n];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                arr[i][j] = '.';
            }
        }

        path(0, pd, td, ld, arr, n);

        return list;
    }

    void path(int clm, int[] pd, int[] td, int[] ld, char[][] arr, int n) {

        if (clm == n) {

            List<String> temp = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                temp.add(new String(arr[i]));
            }

            list.add(temp);
            return;
        }

        for (int i = 0; i < n; i++) {

            // row , upper diagonal , lower diagonal
            if (pd[i] == 0 &&
                td[i + clm] == 0 &&
                ld[n - 1 + clm - i] == 0) {

                arr[i][clm] = 'Q';

                pd[i] = 1;
                td[i + clm] = 1;
                ld[n - 1 + clm - i] = 1;

                path(clm + 1, pd, td, ld, arr, n);

                arr[i][clm] = '.';

                pd[i] = 0;
                td[i + clm] = 0;
                ld[n - 1 + clm - i] = 0;
            }
        }
    }
}
