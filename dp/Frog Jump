https://www.geeksforgeeks.org/problems/geek-jump/1
class Solution {
    int minCost(int[] arr) {
        
        // code here
        int prev1=0;
        int prev=0;
        for(int i=1;i<=arr.length-1;i++)
        {
            int left=Math.abs(arr[i]-arr[i-1])+prev;
            int right=Integer.MAX_VALUE;
            if(i>1)
            {
            right=Math.abs(arr[i]-arr[i-2])+prev1;
            }
            int curr=Math.min(left,right);
            prev1=prev;
            prev=curr;
        }
        return prev;
    }
}
