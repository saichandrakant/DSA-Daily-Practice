https://leetcode.com/problems/koko-eating-bananas/description/
class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int start=1;
        int end=0;
        for(int po:piles)
        {
            end=Math.max(end,po);
        }
        int ans=0;
        while(start<=end)
        {
            int mid=start+(end-start)/2;
            long hrs=0;
            for(int po:piles)
            {
                hrs=hrs+(int)Math.ceil((double)po/mid);
            }
            if(hrs<=h)
            {
                ans=mid;
                end=mid-1;
            }
            else
            {
                start=mid+1;
            }
        }
        return ans;
    }
}
