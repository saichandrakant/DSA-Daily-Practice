https://leetcode.com/problems/search-in-rotated-sorted-array-ii/description/
class Solution {
    public boolean search(int[] nums, int target) {
        int index=0;
        for(int i=1;i<nums.length;i++)
        {
            if(nums[i]<nums[i-1])
            {
                index=i;
                break;
            }
        }
        if(index==0)
        {
            return bs(0,nums.length-1,target,nums);
        }
         if(target>=nums[0])
        {
            return bs(0,index-1,target,nums);
        }
       
        return bs(index,nums.length-1,target,nums);
        
    }
    static boolean bs(int start,int end,int target,int[] nums)
    {
        while(start<=end)
        {
            int mid=start+(end-start)/2;
            if(nums[mid]==target)
            {
                return true;
            }
           else if(target<nums[mid])
            {
                end=mid-1;
            }
            else
            {
                start=mid+1;
            }
        }
        return false;
    }
}
