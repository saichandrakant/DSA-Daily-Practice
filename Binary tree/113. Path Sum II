/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    List<List<Integer>>  list=new ArrayList<>();
    public List<List<Integer>> pathSum(TreeNode root, int targetSum) {
        int sum=0;
        List<Integer> list1=new ArrayList<>();
        inorder(root,targetSum,sum,list1);
        return list;
    }
    void inorder(TreeNode root,int target,int sum,List<Integer> list1)
    {
        if(root==null)
        {
          
            return;
        }
        list1.add(root.val);
        sum=sum+root.val;
          if (root.left == null && root.right == null) {

            if (sum == target) {
                list.add(new ArrayList<>(list1));
            }
          }
          else
          {
        inorder(root.left,target,sum,list1);
        inorder(root.right,target,sum,list1);
          }
          list1.remove(list1.size()-1);
    }
}
