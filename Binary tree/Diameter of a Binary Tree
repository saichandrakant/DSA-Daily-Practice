/*
Definition for Node
class Node {
    int data;
    Node left;
    Node right;
    Node(int data) {
        this.data = data;
        left = right = null;
    }
} */

class Solution {
int ans=0;
    public int diameter(Node root) {
        // code here
        rec(root);
        return ans;
    }
    int rec(Node root)
    {
        if(root==null)
        {
            return 0;
        }
        int left=rec(root.left);
        int right=rec(root.right);
        ans=Math.max(ans,left+right);
        return Math.max(left,right)+1;
    }
}
