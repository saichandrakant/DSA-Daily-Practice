/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int sum=0;
    public int sumNumbers(TreeNode root) {
        if(root.left==null && root.right==null)
        {
            return root.val;
        }
        int ans=0;
        inorder(root,ans);
        return sum;
    }
    void inorder(TreeNode root,int ans)
    {
        if(root==null)
        {
            return;
        }
        if(root.left==null && root.right==null)
        {
            ans=ans*10+root.val;
            sum=sum+ans;
        }
        else
        {
        inorder(root.left,ans*10+root.val);
        inorder(root.right,ans*10+root.val);
        }
    }
}
