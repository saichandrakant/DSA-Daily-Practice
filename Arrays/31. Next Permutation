https://leetcode.com/problems/next-permutation/

class Solution {
    void nextPermutation(int[] arr) {
        int index=-1;
        for(int i=arr.length-2;i>=0;i--)
        {
            if(arr[i]<arr[i+1])
            {
                index=i;
                break;
            }
        }
        if(index==-1)
        {
             reverse(0,arr.length-1,arr);
             return;
        }
        for(int i=arr.length-1;i>index;i--)
        {
            if(arr[i]>arr[index])
            {
                int temp=arr[i];
                arr[i]=arr[index];
                arr[index]=temp;
                break;
            }
        }
        reverse(index+1,arr.length-1,arr);
        return ;
    }
    static void  reverse(int left,int right,int[] arr)
    {
        while(left<right)
        {
            int temp=arr[left];
            arr[left]=arr[right];
            arr[right]=temp;
            left++;
            right--;
        }
    }
}
