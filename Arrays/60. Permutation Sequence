https://leetcode.com/problems/permutation-sequence/description/
class Solution {
    public String getPermutation(int n, int k) {
        int rem=0;
        int[] arr=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=i+1;
        }
        for(int i=1;i<k;i++)
        {
            arr= nxt(arr);
        }
        for(int i=0;i<arr.length;i++)
        {
            rem=rem*10+arr[i];
        }
        return Integer.toString(rem);
    }
    int[] nxt(int[] arr)
    {
        int index=-1;
        for(int i=arr.length-2;i>=0;i--)
        {
            if(arr[i+1]>arr[i])
            {
                index=i;
                break;
            }
        }
         if(index==-1)
        {
            rev(0,arr.length-1,arr);
            return arr;
        }
        for(int i=arr.length-1;i>index;i--)
        {
            if(arr[i]>arr[index])
            {
                int temp=arr[index];
                arr[index]=arr[i];
                arr[i]=temp;
                break;
            }
        }
       
        rev(index+1,arr.length-1,arr);
        return arr;
    }
    void rev(int st,int end,int[] nums)
    {
        while(st<end)
        {
            int temp=nums[st];
            nums[st]=nums[end];
            nums[end]=temp;
            st++;
            end--;
        }
    }
}
