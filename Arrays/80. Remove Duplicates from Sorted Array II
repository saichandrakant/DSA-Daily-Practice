https://leetcode.com/problems/remove-duplicates-from-sorted-array-ii/
class Solution {
    public int removeDuplicates(int[] nums) {
        int index=0;
        int l=0;
        for(int i=0;i<nums.length;i++)
        {
            if(nums[l]!=nums[i])
            {
                l=i;
            }
           if(i-l+1<=2)
            {
                nums[index]=nums[l];
                index++;
            }
        }
        return index;
    }
}
