https://leetcode.com/problems/k-closest-points-to-origin/description/
class Pair
{
    int a;
    int b;
    int c;
    int d;
    Pair(int a,int b,int c,int d)
    {
        this.a=a;
        this.b=b;
        this.c=c;
        this.d=d;
    }
}
class Solution {
    public int[][] kClosest(int[][] points, int k) {
        int[][] ans=new int[k][2];
        TreeMap<Integer,List<Pair>> map=new TreeMap<>();
        for(int i=0;i<points.length;i++)
        {
            int dis=(points[i][0]*points[i][0])+(points[i][1]*points[i][1]);
            if (!map.containsKey(dis)) {
                 map.put(dis, new ArrayList<Pair>());
               }
             map.get(dis).add(new Pair(i,0,i,1));
        }
        int index=0;
        int cnt=0;
       for (List<Pair> list : map.values()) {
            for (Pair p : list) {

                ans[index][0] = points[p.a][p.b];
                ans[index][1] = points[p.c][p.d];

                index++;

                if (index == k) {
                    return ans;
                }
            }
        }
        return ans;
    }
}
