https://leetcode.com/problems/remove-duplicates-from-sorted-array/description/
class Solution {
    public int removeDuplicates(int[] nums) {
        int index=1;
        int l=0;
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]!=nums[l])
            {
                nums[index++]=nums[i];
                l=i;
            }
        }
       return  index;
    }
}
