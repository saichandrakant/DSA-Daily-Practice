https://leetcode.com/problems/container-with-most-water/
class Solution {
    public int maxArea(int[] height) {
        int left=0;
        int right=height.length-1;
        int max=0;
        while(left<right)
        {
            if(height[left]<=height[right])
            {
                max=Math.max(max,Math.abs(left-right)*height[left]);
                left++;
            }
            else
            {
                max=Math.max(max,Math.abs(right-left)*height[right]);
                right--;
            }
        }
        return max;
    }
}
