https://leetcode.com/problems/previous-permutation-with-one-swap/description/
class Solution {
    public int[] prevPermOpt1(int[] arr) {
        int index=-1;
        for(int i=arr.length-2;i>=0;i--)
        {
            if(arr[i]>arr[i+1])
            {
                index=i;
                break;
            }
        }
        if(index==-1)
        {
            return arr;
        }
        int k=-1;
        for(int i=arr.length-1;i>index;i--)
        {
            if(arr[i]<arr[index])
            {
                while(i>index+1 && arr[i]==arr[i-1])
                {
                    i--;
                  
                }
                  k=i;
                    break;
            }
        }

        
   int temp = arr[index];
        arr[index] = arr[k];
        arr[k] = temp;

        return arr;
    }
}
