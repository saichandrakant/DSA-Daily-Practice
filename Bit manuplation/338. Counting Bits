https://leetcode.com/problems/counting-bits/description/
class Solution {
    public int[] countBits(int n) {
        int[] arr= new int[n+1];
        
        while(n>0)
        {
            
            arr[n]=cnt(n);
            n--;
        }
        return arr;
    }
    int  cnt(int n)
    {
        int cnt=0;
        while(n>0)
        {
            n=n&(n-1);
            cnt++;
        }
        return cnt;
    }
}
