/*
class Node {
    int data;
    Node next;

    Node(int d)
    {
        data = d;
        next = null;
    }
}*/

class Solution {
    public Node segregate(Node head) {
        // code here
        int cnt1=0;
        int cnt2=0;
        int cnt3=0;
        Node temp=head;
        while(temp!=null)
        {
            if(temp.data==0)
            {
                cnt1++;
            }
            else if(temp.data==1)
            {
                cnt2++;
            }
            else
            {
                cnt3++;
            }
            temp=temp.next;
        }
        int index=1;
        temp=head;
        while(temp!=null)
        {
            if(index<=cnt1)
            {
                temp.data=0;
            }
            else if(index<=cnt1+cnt2)
            {
                temp.data=1;
            }
            else
            {
                temp.data=2;
            }
            temp=temp.next;
            index++;
        }
        return head;
    }
}
