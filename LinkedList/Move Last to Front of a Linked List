class Solution {
    public static Node moveToFront(Node head) {
        if(head==null || head.next==null)
        {
            return head;
        }
      Node prev=null;
      Node temp=head;
        while(temp.next!=null)
        {
            prev=temp;
            temp=temp.next;
        }
        prev.next=null;
        temp.next=head;
        return temp;
    }
}
