https://www.geeksforgeeks.org/problems/remove-duplicate-element-from-sorted-linked-list/1
/* Structure of linked list Node
class Node {
    int data;
    Node next;

    Node(int d) {
      data = d;
      next = null;
    }
}
*/
class Solution {
    Node removeDuplicates(Node head) {
        // code here
        if(head==null|| head.next==null)
        {
            return head;
        }
        Node prev=head;
        Node temp=head.next;
        while(temp!=null)
        {
            if(temp.data!=prev.data)
            {
                prev.next=temp;
                prev=temp;
            }
            temp=temp.next;
        }
        prev.next=null;
        return head;
    }
}
