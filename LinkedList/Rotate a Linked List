class Solution {
    public Node rotate(Node head, int k) {
        // code here
        if(head==null)
        {
            return null;
        }
        Node temp=head;
       
        int size=0;
        while(temp.next!=null)
        {
            size++;
          
            temp=temp.next;
        }
        size++;
        k=k%size;
        if(k==0)
        {
            return head;
        }
       int index=1;
        Node kaj=head;
        while(index<k)
        {
            kaj=kaj.next;
            index++;
        }
        Node temper=kaj.next;
        kaj.next=null;
        temp.next=head;
        return temper;
    }
}
