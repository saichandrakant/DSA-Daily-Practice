    public ListNode middleNode(ListNode head) {
        int cnt=0;
        ListNode temp=head;
        if(head==null)
        {
            return null;
        }
        while(temp!= null)
        {
            cnt++;
            temp=temp.next;
        }
        int i=0;
        int mid=0+(cnt-0)/2;
        temp=head;
        while(i<mid)
        {
            temp=temp.next;
            i++;
        }
        return temp;
    }
}
